# CallVerse environment (copy to .env). Values here override configs/*.yaml.
# development or production; INFO = the normal amount of logs.
CALLVERSE_ENV=development
CALLVERSE_LOG_LEVEL=INFO

# Storage paths (relative to the project root)
CALLVERSE_DATA_DIR=data
CALLVERSE_ARTIFACTS_DIR=artifacts

# Main LLM provider: OpenRouter (hosted open models, free tier). Create a key on
# https://openrouter.ai/keys and paste it here; never commit .env. If a free model answers
# "No endpoints found matching your data policy", allow free endpoints in
# https://openrouter.ai/settings/privacy (free providers may log prompts).
# Without a key (or when the free daily quota is used up) the local models below are used.
OPENROUTER_API_KEY=
# openrouter (default in configs/agents.yaml) or transformers (local models only)
CALLVERSE_LLM_PROVIDER=openrouter

# Local Hugging Face LLMs (transformers). Profile "gpu4gb" = 4-bit weights for a 4 GB GPU;
# "full" = full-precision weights (>= 12 GB GPU). Download once: `callverse llm-pull`.
CALLVERSE_LLM_MODE=auto
CALLVERSE_LLM_PROFILE=gpu4gb
CALLVERSE_LLM_DEVICE=auto
# auto = bge-m3 + FAISS when available, keyword = TF-IDF baseline (instant start)
CALLVERSE_RETRIEVER=auto
# Load Hugging Face models (bge-m3, LLMs) from the local cache only; `callverse llm-pull`
# goes online by itself.
HF_HUB_OFFLINE=1

# Experiment tracking (empty = local SQLite mlflow.db)
MLFLOW_TRACKING_URI=
MLFLOW_DISABLE_AGENT_HINT=1
# Password of the MLflow Postgres database in docker-compose.yml (a local default: change it for a real
# server).
MLFLOW_DB_PASSWORD=mlflow

# Optional Langfuse tracing (leave empty to trace to artifacts/traces/llm_calls.jsonl only)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Random seed for reproducibility (configs hold the per-module seeds)
CALLVERSE_RANDOM_SEED=42
