# CallVerse environment (copy to .env). Values here override configs/*.yaml.
CALLVERSE_ENV=development
CALLVERSE_LOG_LEVEL=INFO

# Storage paths (relative to the project root)
CALLVERSE_DATA_DIR=data
CALLVERSE_ARTIFACTS_DIR=artifacts

# Local LLMs (Ollama). Profile "fast" fits a 4 GB GPU; "full" uses the 7B advisor.
OLLAMA_HOST=http://localhost:11434
CALLVERSE_LLM_MODE=auto
CALLVERSE_LLM_PROFILE=fast
# auto = bge-m3 + FAISS when available, keyword = TF-IDF baseline (instant start)
CALLVERSE_RETRIEVER=auto
# Use the locally cached bge-m3 (set to 0 the first time to download it)
HF_HUB_OFFLINE=1

# Experiment tracking (empty = local SQLite mlflow.db)
MLFLOW_TRACKING_URI=
MLFLOW_DISABLE_AGENT_HINT=1
MLFLOW_DB_PASSWORD=mlflow

# Optional Langfuse tracing (leave empty to trace to artifacts/traces/llm_calls.jsonl only)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Random seed for reproducibility (configs hold the per-module seeds)
CALLVERSE_RANDOM_SEED=42
