# CallVerse Environment Configuration
CALLVERSE_ENV=development
CALLVERSE_LOG_LEVEL=INFO

# Storage paths
CALLVERSE_DATA_DIR=data
CALLVERSE_ARTIFACTS_DIR=artifacts

# Server configuration
CALLVERSE_API_HOST=0.0.0.0
CALLVERSE_API_PORT=8000
CALLVERSE_DASHBOARD_PORT=8501

# Random seed for reproducibility
CALLVERSE_RANDOM_SEED=42
